+    _, label, stats, _ = cv2.connectedComponentsWithStats(grown, connectivity=8)
+    extent = np.hypot(stats[:, cv2.CC_STAT_WIDTH], stats[:, cv2.CC_STAT_HEIGHT])
+    keep = extent >= length
+    keep[0] = False
+    return runs & keep[label]

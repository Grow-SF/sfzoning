+def _word_batch():
+    sd, = shrink.prepare([_sheet([((40, 60, 100, 80), 0), ((100, 60, 160, 80), 0), ((160, 40, 180, 160), 90)])],
+                         0.5)
+    return [data.crop_targets(sd, 90, 110, 64, 0.5, 0, words=True), data.crop_targets(sd, 100, 150, 64, 1.3, 1,
+                                                                                         words=True)]

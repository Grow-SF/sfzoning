+    smooth = cv2.GaussianBlur(acc, (0, 0), sigma, borderType=cv2.BORDER_CONSTANT)
+    pad = np.pad(smooth, 1, constant_values=-np.inf)
+    best = smooth.copy()
+    here = np.arange(h * wd, dtype=np.int64).reshape(h, wd)
+    step = here.copy()
+    for dy in (-1, 0, 1):
+        for dx in (-1, 0, 1):
+            if dy or dx:
+                nb = pad[1 + dy:1 + dy + h, 1 + dx:1 + dx + wd]

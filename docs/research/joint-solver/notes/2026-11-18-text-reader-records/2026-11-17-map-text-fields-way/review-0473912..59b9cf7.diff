+def _dist(rows=200, line=0.0, neighbour=0.0, seed=0):
+    rng = np.random.default_rng(seed)
+    off = {"start": rng.normal(-0.4, 0.1, rows), "end": rng.normal(0.5, 0.1, rows),
+           "cross": rng.normal(0.2, 0.05, rows), "angle": rng.normal(5.0, 2.0, rows),
+           "height_ratio": rng.normal(1.3, 0.1, rows)}
+    return {"n": rows, "offsets": {k: v.tolist() for k, v in off.items()},
+            "mean": {k: float(np.mean(v)) for k, v in off.items()}, "line_share": line, "neighbour_share": neighbour,
+            "neighbour_part": [0.1, 0.3]}
+
+
+def _line_piece():
+    p = np.full((60, 3), 255, np.uint8)
+    p[:, 1] = 0
+    return p
+
+
+def test_sloppy_crops_offsets_follow_the_distribution():
+    page, where = _page()
+    terra = RC.with_neighbours(_terra(where))
+    word = terra[terra["word"] == 0].iloc[0]
+    dist = _dist(line=0.3, neighbour=0.4)
+    rng = np.random.default_rng(5)
+    drawn = []
+    for _ in range(500):
+        info = {}
+        crop = RC.sloppy_crop(page, word, dist, [_line_piece()], rng, info)
+        assert crop.dtype == np.uint8 and crop.shape[0] == model.HEIGHT
+        drawn.append(info)
+    got = pd.DataFrame(drawn)
+    for k, m in dist["mean"].items():
+        assert abs(got[k].mean() - m) <= 0.1 * abs(m), k
+    for k, p in (("line", 0.3), ("neighbour", 0.4)):
+        assert abs(got[k].mean() - p) < 4 * math.sqrt(p * (1 - p) / len(got)), k
+
+
+def _zero(line=0.0, neighbour=0.0, part=(0.25,)):
+    return {"n": 1, "offsets": {k: [v] for k, v in (("start", 0.0), ("end", 0.0), ("cross", 0.0), ("angle", 0.0),
+                                                     ("height_ratio", 1.0))},
+            "line_share": line, "neighbour_share": neighbour, "neighbour_part": list(part)}
+

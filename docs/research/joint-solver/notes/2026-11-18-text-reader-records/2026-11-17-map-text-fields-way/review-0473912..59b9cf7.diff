+def test_offset_distribution_measures_ends_cross_angle_height_lines_and_neighbours():
+    """A's box starts 3 px early, ends 6 px late, sits 2.4 px low and is 30 px tall (A: 36 x 24); B's (reading at 180
+    degrees) runs 2 px past B's end (its left).  A holds line ink and a quarter of E; B neither."""

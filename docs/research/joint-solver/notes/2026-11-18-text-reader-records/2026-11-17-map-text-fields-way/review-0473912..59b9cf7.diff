+    assert d["line_share"] == 0.5
+    assert d["neighbour_share"] == 0.5
+    np.testing.assert_allclose(d["neighbour_part"], [0.25], atol=1e-9)
+    np.testing.assert_allclose(d["mean"]["start"], -3 / 48, atol=1e-9)

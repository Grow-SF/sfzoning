+    weighted = dataclasses.replace(sd, weights=np.array([0.25, 0.5, 0.75], np.float32))
+    for y, x, size, scale, turns in ((90, 110, 64, 0.5, 0), (100, 150, 64, 1.3, 1), (70, 120, 48, 1.0, 3)):
+        plain = data.crop_targets(sd, y, x, size, scale, turns)

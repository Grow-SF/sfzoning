+AREA_CORNER = (319.5, 319.5)      # page px of VALIDATION_AREA's north-west corner: rows and columns 320 on are in it
+EDGE_WORDS = [([300, 400, 380, 430], "zoning code", 0),    # P: across the area's west edge, its centre (340, 415) in it

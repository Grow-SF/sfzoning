+def _edge_page() -> np.ndarray:
+    """The page of EDGE_WORDS: each word's ink a block inside its box; a thin line 1,040 ft long whose last 160 ft
+    are in the area; ink at Sol's point."""
+    gray = np.full((SIZE, SIZE), 255, np.uint8)

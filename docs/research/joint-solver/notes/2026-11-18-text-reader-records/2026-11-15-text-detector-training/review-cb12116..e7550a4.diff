+    disc = np.zeros(gray.shape, np.uint8)
+    cv2.circle(disc, EDGE_POINT, data.READ_POINT_RADIUS, 1, -1)
+    return {"ink": ink, "area": area, "text": text, "unknown": (disc > 0) & ~text}

+    assert [(s.series, s.sheet) for s in sheets] == [(paths.SERIES, SHEET), (OLD, OLD_SHEET)]
+    centres = [(115, 140), (140, 460), (320, 330), (430, 450), (5, 630), (639, 0), (330, 300), (470, 200)]
+    for sd in sheets:

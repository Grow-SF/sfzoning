+        x, y = a[0, 0] * u + a[0, 1] * v + a[0, 2], a[1, 0] * u + a[1, 1] * v + a[1, 2]
+        ok = (x >= 0) & (x < image.shape[1]) & (y >= 0) & (y < image.shape[0])
+        out = np.full((h, w), fill, image.dtype)
+        out[ok] = image[y[ok], x[ok]]
+        return out
+    x0, y0, x1, y1 = _footprint(a, shape, 1, image.shape)

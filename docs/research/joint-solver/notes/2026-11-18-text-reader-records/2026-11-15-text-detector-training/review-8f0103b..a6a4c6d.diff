+    is_long = np.zeros(int(nearest.max()) + 1, bool)
+    is_long[nearest[centre]] = on_long[centre]
+    piece_of = np.zeros(len(is_long), np.int32)
+    piece_of[nearest[centre]] = piece[centre]
+    return ink & is_long[nearest] & (piece_of[nearest] == piece)

+    is_kept = np.zeros(int(nearest.max()) + 1, bool)
+    is_kept[nearest[centre]] = on_kept[centre]
+    piece_of = np.zeros(len(is_kept), np.int32)
+    piece_of[nearest[centre]] = piece[centre]
+    return ink & is_kept[nearest] & (piece_of[nearest] == piece)

+    return {"angle_deg": angle, "direction": "left-to-right" if angle == 0 else "slanted", "kind": kind,
+            "text": text, "x0": x0 - tile[0], "x1": x1 - tile[0], "y0": y0 - tile[1], "y1": y1 - tile[1]}

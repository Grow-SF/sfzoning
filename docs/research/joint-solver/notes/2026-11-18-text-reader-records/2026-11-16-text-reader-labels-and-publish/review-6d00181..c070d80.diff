--- /dev/null
+++ b/pipeline/src/sfzmaps/solver/textread/store.py
@@ -0,0 +1,88 @@
+"""Where the text reader's three stages write, and the files they share.
+
+  data/solver/text-crops/   (solver-text-crops)
+    crops.npz, crops.parquet   every real crop and its row (`crops`)
+    answered.parquet           every answered label of the owner's code check: its point, answer, quarter, and the
+                               row of its crop at Terra's box (-1 without one)
+    font.npz, prior.json       the template reader's font and prior, learned from the training labels (`synth`)
+    synth_<q>.npz, .parquet    quarter q's reader's synthetic code crops
+    summary.json
+  data/solver/text-train/   (solver-text-train)
+    <q>.pt, <q>_direction.pt   quarter q's reader and 0/180 classifier
+    held.json                  per quarter: what was trained on, the seeds and recipes, the direction prior
+    log.json                   the training logs
+  data/solver/text-read/    (solver-text-read)
+    reads.npz, reads.parquet   every word box's reading (`read`)
+    answered.parquet           every answered label's readings, at Terra's box and at our box
+    measures.json
+
+A crop is uint8, HEIGHT px tall, paper 255, reading left to right.  A set of crops is stored flat: crop i is
+`flat[:, offsets[i]:offsets[i + 1]]`.  Every .npz is written with fixed dates (`save_npz`): the same arrays, the same
+bytes.
+"""
+import zipfile
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+from sfzmaps.solver import paths
+
+CROPS_DIR = paths.SOLVER_DIR / "text-crops"
+TRAIN_DIR = paths.SOLVER_DIR / "text-train"
+READ_DIR = paths.SOLVER_DIR / "text-read"
+NPZ_DATE = (1980, 1, 1, 0, 0, 0)
+TOUCH = tuple(f"touch_{q}" for q in paths.QUARTERS) + ("touch_blocks",)   # the held-out areas a crop touches
+
+
+def save_npz(f: Path, **arrays) -> None:
+    """A compressed .npz whose members are dated NPZ_DATE (numpy dates them now)."""
+    with zipfile.ZipFile(f, "w", zipfile.ZIP_DEFLATED) as z:
+        for name, a in arrays.items():
+            info = zipfile.ZipInfo(f"{name}.npy", NPZ_DATE)
+            info.compress_type = zipfile.ZIP_DEFLATED
+            with z.open(info, "w", force_zip64=True) as member:
+                np.lib.format.write_array(member, np.asanyarray(a), allow_pickle=False)
+
+
+class Crops:
+    """A set of crops (see the module): `crops[i]` is crop i."""
+
+    def __init__(self, flat: np.ndarray, offsets: np.ndarray):
+        self.flat, self.offsets = flat, offsets
+
+    @classmethod
+    def of(cls, crops: list[np.ndarray], height: int) -> "Crops":
+        widths = np.array([c.shape[1] for c in crops], np.int64)
+        offsets = np.concatenate([[0], np.cumsum(widths)]).astype(np.int64)
+        flat = np.concatenate(crops, axis=1) if crops else np.zeros((height, 0), np.uint8)
+        return cls(np.ascontiguousarray(flat, np.uint8), offsets)
+
+    @classmethod
+    def load(cls, f: Path) -> "Crops":
+        with np.load(f) as z:
+            return cls(z["flat"], z["offsets"])
+
+    def save(self, f: Path) -> None:
+        save_npz(f, flat=self.flat, offsets=self.offsets)
+
+    def __len__(self) -> int:
+        return len(self.offsets) - 1
+
+    def __getitem__(self, i: int) -> np.ndarray:
+        return self.flat[:, self.offsets[i]:self.offsets[i + 1]]
+
+    @property
+    def widths(self) -> np.ndarray:
+        return np.diff(self.offsets)
+
+
+def training_rows(rows: pd.DataFrame, q: int, text_only: bool = False) -> np.ndarray:
+    """The rows of crops.parquet quarter q's reader may train on: a target (Terra's string in the reader's alphabet,
+    or "" for a non-text window), and a footprint touching neither quarter q nor the answered blocks; `text_only`:
+    words only."""
+    ok = rows["text"].notna().to_numpy() & ~rows[f"touch_{paths.QUARTERS[q]}"].to_numpy(bool) \
+        & ~rows["touch_blocks"].to_numpy(bool)
+    if text_only:
+        ok &= (rows["kind"] != "none").to_numpy()
+    return np.flatnonzero(ok)
diff --git a/pipeline/src/sfzmaps/solver/textread/synth.py b/pipeline/src/sfzmaps/solver/textread/synth.py
new file mode 100644
index 0000000..7812b14
--- /dev/null
+++ b/pipeline/src/sfzmaps/solver/textread/synth.py
@@ -0,0 +1,223 @@
+"""The synthetic code crops the text reader adds to its real ones (spike S2's reader C), and the template reader's
+inputs they are drawn with.
+
+The template reader's inputs (`learn_template`), learned as the template reader learns them, from its training
+labels (`codereader.labels.training`: every print that no owner's answer joined, in a block no answer reaches; one
+font for the whole map, not one per quarter: the lettering is the same everywhere, so it carries glyph shape and no
+label):
+  font   `codereader.glyphs.learn_font` on the training labels' crops and their strings (`glyphs.consensus` of the
+         saved reads), line px by glyphs.RULES unobserved, the characters of the code list besides the strings'
+  prior  `codereader.posterior.Prior.learn` on the same labels and font: the code list's printed forms (the table's
+         code NAMES, never a code at a label's spot; the aliases; the forms the training reads wrote), p(code) and
+         p(form | code) from the training strings, and the pose prior (Terra's box about the drawn ink, the cap
+         height over the word's height)
+The code list the reader is scored on is this prior's `forms` (printed form -> code).
+
+Each synthetic crop (`synth_crop`) is a printed code form drawn by the font and its noise, cut like a real crop
+(`crops.rectify`'s pads, HEIGHT px tall).  Everything drawn is measured:
+  the string     a code by p(code) half the time and uniformly the other half (rare codes seen), then one of its
+                 printed forms by p(form | code) half the time and uniformly the other half
+  the size       a training code word's height (the real crops, every scan, Terra's word) times the cap height over
+                 word height, log-normal with the pose prior's measured mean and sd (`ratio`)
+  the spacing    each character's pen moved by a Gaussian with the font's measured gap spread / sqrt 2
+  the angle      a residual turn of N(0, RESIDUAL_SD) degrees
+  the ink        each px ink with the noise's p(ink) at its signed distance from the drawn strokes, rescaled to run
+                 from the pages' measured speck rate (`speck_rate`) far off the strokes to the noise's own value on
+                 them (the noise's far value is the crops' clutter, not paper flips)
+  Terra's box    its ends and middle off the drawn ink by the pose prior's measured core-and-tail Gaussians
+  the lines      with the measured share of training code words whose Terra word holds line ink by the "run" rule
+                 (`line_share`), a real non-text window of the 2000 scan laid over the crop (the darker px of the
+                 two), cut at the synthetic word's own page size (`Overlays`)
+Quarter q's reader gets its own set (`make_synth`): the heights, the line share and the line windows come from the
+real crops it may train on (touching neither q nor the answered blocks).  The sampling is C's as the spike ran it,
+known faults kept so that it is the recipe C was measured with: Terra's box offsets drawn with the opposite sign
+(means 0.02-0.03 word heights), and line windows centred on ink (a line often runs through the word's middle).
+Seeded per quarter; one thread.
+"""
+import math
+import time
+
+import cv2
+import numpy as np
+import pandas as pd
+
+from sfzmaps.solver import paths
+from sfzmaps.solver.codereader import glyphs, labels as L, posterior as P
+from sfzmaps.solver.textnet import data
+from sfzmaps.solver.textread import crops as K
+from sfzmaps.solver.textread import store
+
+N = 50000                  # synthetic crops per quarter (reader C's count)
+SEED = 20261117
+RESIDUAL_SD = 1.5          # degrees
+LINE_MIN_PX = 3            # a word holds line ink when at least this many of its px are on a "run" line
+LINE_WORDS = 1500          # code words the line share is measured on, at most
+SPECK_PX = 2               # an ink component this small (8-connected px) on a page is a speck
+
+
+# --- the template reader's inputs -----------------------------------------------------------------------------------
+
+def learn_template(labels: list, workers: int | None = None) -> tuple[glyphs.Font, P.Prior, dict]:
+    """The font and the prior (see the module) from `labels` (`codereader.labels.load_labels()`, with crops), and
+    what they were learned from."""
+    t0 = time.perf_counter()
+    train = L.training(labels)
+    charset = "".join(sorted(set("".join(L.code_list(labels)))))
+    observed = [~L.line_mask(lab, rules=glyphs.RULES) for lab in train]
+    texts = [glyphs.consensus(lab) for lab in train]
+    font = glyphs.learn_font(train, texts=texts, observed=observed, charset=charset, workers=workers)
+    t1 = time.perf_counter()
+    prior = P.Prior.learn(train, font, font.noise, workers=workers)
+    info = {"training_labels": len(train), "labels": len(labels), "charset": charset,
+            "strings_not_terra": int(sum(t != lab.terra_text for t, lab in zip(texts, train))),
+            "font_trace": [{k: v for k, v in r.items() if k not in ("weights", "seconds")} for r in font.trace],
+            "forms": len(prior.forms), "codes": len(prior.codes),
+            "seconds": {"font": round(t1 - t0, 1), "prior": round(time.perf_counter() - t1, 1)}}
+    return font, prior, info
+
+
+# --- what the sampling measures -------------------------------------------------------------------------------------
+
+def line_share(rows: pd.DataFrame, seed: int = 0) -> dict:
+    """The share of `rows` (code words of the 2000 scan) whose Terra word rectangle holds line ink by the "run"
+    rule, measured on the page around each (the window grown by the rule's run length), on at most LINE_WORDS."""
+    m = rows.iloc[np.random.default_rng(seed).permutation(len(rows))[:LINE_WORDS]]
+    hits = total = 0
+    for sheet, part in m.groupby("sheet", sort=True):
+        page = data.load_page(sheet)
+        run = L.run_px(data.load_transform(sheet).median_scale_ft_per_px(page.shape))
+        for b, angle in zip(part[["box_x0", "box_y0", "box_x1", "box_y1"]].to_numpy(float), part["angle"]):
+            rect = data.word_rect(b, float(angle))
+            x0, y0 = np.floor(rect.min(axis=0)).astype(int) - run
+            x1, y1 = np.ceil(rect.max(axis=0)).astype(int) + run + 1
+            x0, y0, x1, y1 = max(x0, 0), max(y0, 0), min(x1, page.shape[1]), min(y1, page.shape[0])
+            ink = page[y0:y1, x0:x1] < 128
+            lines = L.run_lines(ink, run)
+            inside = np.zeros(ink.shape, np.uint8)
+            cv2.fillPoly(inside, [np.round(rect - [x0, y0]).astype(np.int32).reshape(-1, 1, 2)], 1)
+            hits += int((lines & (inside > 0)).sum() >= LINE_MIN_PX)
+            total += 1
+    return {"words": total, "with_line_ink": hits, "share": hits / max(total, 1)}
+
+
+def speck_rate(sheets) -> dict:
+    """The share of paper px that are specks (ink px in 8-connected components of SPECK_PX px or fewer) over every px
+    not in a larger component, on the given 2000 pages."""
+    specks = paper = 0
+    for sheet in sheets:
+        ink = (data.load_page(sheet) < 128).astype(np.uint8)
+        _, _, stats, _ = cv2.connectedComponentsWithStats(ink, connectivity=8)
+        size = stats[:, cv2.CC_STAT_AREA]
+        small = size[1:] <= SPECK_PX
+        specks += int(size[1:][small].sum())
+        paper += int(ink.size - size[1:][~small].sum())
+    return {"sheets": len(sheets), "speck_px": specks, "paper_px": paper, "rate": specks / max(paper, 1)}
+
+
+class Overlays:
+    """Line windows from non-text crops of the 2000 scan (`rows`), cut at a synthetic word's own page size."""
+
+    def __init__(self, rows: pd.DataFrame):
+        self.rows = rows.reset_index(drop=True)
+        size = [L.word_size(b, float(a)) for b, a in
+                zip(self.rows[["box_x0", "box_y0", "box_x1", "box_y1"]].to_numpy(float), self.rows["angle"])]
+        self.win_w = np.array([ln + 2 * K.PAD_X * h for ln, h in size]).reshape(-1)
+        self.win_h = np.array([h * (1 + 2 * K.PAD_Y) for _, h in size]).reshape(-1)
+        self.pages: dict[str, np.ndarray] = {}
+
+    def cut(self, w: int, h: int, out_shape: tuple[int, int], rng) -> np.ndarray | None:
+        """A page window w x h px from inside a checked-empty window at least that large, at that window's angle,
+        resized like the crop to `out_shape`; None when no window is large enough."""
+        ok = np.flatnonzero((self.win_w >= w) & (self.win_h >= h))
+        if not len(ok):
+            return None
+        r = self.rows.iloc[int(ok[rng.integers(len(ok))])]
+        if r["sheet"] not in self.pages:
+            self.pages[r["sheet"]] = data.load_page(r["sheet"])
+        b = (r["box_x0"], r["box_y0"], r["box_x1"], r["box_y1"])
+        a = L.frame(((b[0] + b[2] - 1) / 2, (b[1] + b[3] - 1) / 2), w, h, float(r["angle"]))
+        raw = L.sample(self.pages[r["sheet"]], a, (h, w), 255)
+        return cv2.resize(raw, (out_shape[1], out_shape[0]),
+                          interpolation=cv2.INTER_AREA if h > out_shape[0] else cv2.INTER_LINEAR)
+
+
+# --- drawing --------------------------------------------------------------------------------------------------------
+
+def draw_form(prior: P.Prior, rng) -> str:
+    codes = sorted(prior.codes)
+    p = np.array([prior.codes[c] for c in codes])
+    code = codes[rng.choice(len(codes), p=p / p.sum())] if rng.random() < 0.5 else codes[rng.integers(len(codes))]
+    forms = sorted(f for f, c in prior.forms.items() if c == code)
+    w = np.array([prior.form_weights.get(f, 1.0) for f in forms])
+    return forms[rng.choice(len(forms), p=w / w.sum())] if rng.random() < 0.5 else forms[rng.integers(len(forms))]
+
+
+def _mix(rng, mean: float, core: float, tail: float, w_tail: float) -> float:
+    return mean + rng.normal() * (tail if rng.random() < w_tail else core)
+
+
+def synth_crop(font: glyphs.Font, p_ink, pose: P.PosePrior, text: str, word_h: float, rng,
+               overlays: "Overlays | None") -> tuple[np.ndarray, bool]:
+    """One synthetic crop of `text` (see the module), and whether a line window was laid over it."""
+    cap = word_h * math.exp(rng.normal(pose.ratio[0], pose.ratio[1]))
+    scale = cap / font.size
+    chars, xs = font.layout(text)
+    xs = xs + rng.normal(0.0, font.spacing_sd / math.sqrt(2), len(xs))
+    laid = glyphs.lay(font, chars, xs, np.zeros(len(chars)))
+    angle = rng.normal(0.0, RESIDUAL_SD)
+    extent = (len(text) + 4) * font.size * scale + 4 * word_h
+    w = int(math.ceil(extent)) + 8
+    h = int(math.ceil(word_h * 4)) + 8
+    d = glyphs._warp(laid, glyphs.Pose((w - 1) / 2, (h - 1) / 2, scale, angle), (h, w))
+    ink = rng.random(d.shape) < p_ink(d)
+    cols = np.flatnonzero((d > 0).any(axis=0))
+    rows = np.flatnonzero((d > 0).any(axis=1))
+    if not len(cols):
+        cols, rows = np.array([w // 2]), np.array([h // 2])
+    left = cols[0] + word_h * _mix(rng, *pose.left, pose.box_tail)
+    right = cols[-1] + 1 + word_h * _mix(rng, *pose.right, pose.box_tail)
+    if right - left < 0.5 * word_h:
+        right = left + 0.5 * word_h
+    mid = (rows[0] + rows[-1] + 1) / 2 + word_h * _mix(rng, *pose.middle, pose.box_tail)
+    page = np.where(ink, 0, 255).astype(np.uint8)
+    box = (left, mid - word_h / 2, right, mid + word_h / 2)
+    crop, _, shape, _ = K.rectify(page, box, 0.0)
+    if overlays is not None:
+        ov = overlays.cut(shape[1], shape[0], crop.shape, rng)
+        if ov is not None:
+            return np.minimum(crop, ov), True
+    return crop, False
+
+
+def make_synth(q: int, font: glyphs.Font, prior: P.Prior, rows: pd.DataFrame, specks: dict, n: int = N) -> dict:
+    """Quarter q's reader's synthetic crops (see the module): {"crops": list, "rows": DataFrame (text, code,
+    overlay, overlay_wanted), "summary": dict}.  `rows`: the real crops' rows (`crops.make_crops`); `specks`:
+    `speck_rate` of the 2000 pages."""
+    t0 = time.perf_counter()
+    cv2.setNumThreads(1)
+    mine = rows.iloc[store.training_rows(rows, q)]
+    codes = mine[mine["kind"] == "zoning code"]
+    share = line_share(codes[codes["series"] == paths.SERIES])
+    overlays = Overlays(mine[(mine["kind"] == "none") & (mine["series"] == paths.SERIES)])
+    noise, sp = font.noise, specks["rate"]
+    bg = noise.background
+
+    def p_ink(dist):
+        return sp + np.clip(noise.p_ink(dist) - bg, 0, None) / (1 - bg) * (1 - sp)
+
+    code_h = codes["height"].to_numpy(float)
+    rng = np.random.default_rng([SEED, q])
+    out, meta = [], []
+    for _ in range(n):
+        text = draw_form(prior, rng)
+        want = rng.random() < share["share"]
+        crop, lined = synth_crop(font, p_ink, prior.pose, text, float(code_h[rng.integers(len(code_h))]), rng,
+                                 overlays if want else None)
+        out.append(crop)
+        meta.append({"text": text, "code": prior.forms[text], "overlay": lined, "overlay_wanted": bool(want)})
+    df = pd.DataFrame(meta)
+    summary = {"quarter": paths.QUARTERS[q], "crops": n, "seed": [SEED, q], "line_share": share,
+               "code_heights": int(len(code_h)), "line_windows": int(len(overlays.rows)),
+               "residual_sd": RESIDUAL_SD, "overlaid": int(df["overlay"].sum()),
+               "codes": int(df["code"].nunique()), "seconds": round(time.perf_counter() - t0, 1)}
+    return {"crops": out, "rows": df, "summary": summary}
diff --git a/pipeline/src/sfzmaps/solver/textread/train.py b/pipeline/src/sfzmaps/solver/textread/train.py
new file mode 100644
index 0000000..789fcbb
--- /dev/null
+++ b/pipeline/src/sfzmaps/solver/textread/train.py
@@ -0,0 +1,283 @@
+"""The text reader's training (stage `solver-text-train`, `sfzmaps solver text-train`): for each quarter of the city
+(`paths.QUARTERS`), a reader and a 0/180 classifier that never saw that quarter or any answered block, by spike S2's
+recipes (reader C and classifier D), from scratch.
+
+Quarter q's data (`solver-text-crops`): the real crops whose footprint touches neither q nor the answered blocks
+(`store.training_rows`: every kind, the non-text windows with target "" weighted 1 - Terra's miss rate), and for the
+reader its own synthetic code crops (`synth_<q>`), SYNTH_SHARE of each draw.
+
+A step draws BUCKET x BATCH crops from one seeded numpy generator, sorts them by width and cuts them into BUCKET batches
+(less padding), used in a shuffled order.  Each crop is lightly augmented from the same generator: its width scaled
+by up to WIDTH_JITTER either way, a few px of paper added at either end, a shift of up to SHIFT px up or down.  The
+reader's loss: CTC's negative log likelihood of each crop's string over its length (1 for ""), weighted, the
+weighted mean over the batch.  The classifier's: each crop turned a half turn or not (a fair coin from the generator),
+binary cross-entropy on the turn.  AdamW (weight decay 1e-4) on a one-cycle schedule, gradients clipped at norm 5, a
+fixed number of steps (no early stopping, nothing chosen on held-out crops).  Every LOG_EVERY steps the mean loss is
+logged, and for a reader the best-path character error on up to MONITOR words of the held-out quarter on the 2000 scan
+(logged only: nothing is chosen by it).
+
+Each training runs in its own exclusive turn on the Mac's GPU (`sfzmaps.gpu`), one after another, so a waiting process
+can take the GPU between them.  Seeded (torch and numpy, SEED); spike S2 found two runs of its loop on the GPU
+identical step for step.
+
+The direction prior (`ctc.axis_prior`): for each quarter, the share of its training words (every kind, Terra's
+reading angle) that read their axis's half turn, by axis.
+
+Writes data/solver/text-train/ (`store.TRAIN_DIR`): <q>.pt and <q>_direction.pt (`model.save`, with the recipe, the
+seed and the counts), axis_prior.npz (`table_<q>`, `step`, `sd`), held.json (no times in it) and log.json (the
+steps' losses and times).
+"""
+import json
+import logging
+import math
+import time
+
+import cv2
+import numpy as np
+import pandas as pd
+import torch
+import torch.nn.functional as F
+
+from sfzmaps import gpu
+from sfzmaps.solver import paths, runs
+from sfzmaps.solver.textread import ctc, model, store
+
+log = logging.getLogger(__name__)
+
+BATCH = 64
+BUCKET = 8
+WIDTH_JITTER = 0.12
+SHIFT = 2
+END_PAD = 6
+SYNTH_SHARE = 0.4
+LOG_EVERY = 500
+LOSS_EVERY = 50          # the loss is read from the device every this many steps (and at the last)
+MONITOR = 600
+MONITOR_SEED = 7
+SEED = 0
+THREADS = 4              # torch's CPU threads while training (spike S2's)
+READER = {"steps": 12000, "max_lr": 1.5e-3, "pct_start": 0.15, "synth": True}       # reader C
+DIRECTION = {"steps": 3000, "max_lr": 2e-3, "pct_start": 0.15, "synth": False}      # classifier D
+WEIGHT_DECAY = 1e-4
+CLIP = 5.0
+
+
+def default_device() -> str:
+    return "mps" if torch.backends.mps.is_available() else "cpu"
+
+
+def augment(crop: np.ndarray, rng) -> np.ndarray:
+    """A crop's width scaled by up to WIDTH_JITTER either way, 0-END_PAD px of paper added at each end, shifted by up
+    to SHIFT px up or down (paper filling)."""
+    h, w = crop.shape
+    nw = max(8, int(round(w * math.exp(rng.uniform(-WIDTH_JITTER, WIDTH_JITTER)))))
+    out = cv2.resize(crop, (nw, h), interpolation=cv2.INTER_AREA if nw < w else cv2.INTER_LINEAR)
+    left, right = int(rng.integers(0, END_PAD + 1)), int(rng.integers(0, END_PAD + 1))
+    out = np.pad(out, ((0, 0), (left, right)), constant_values=255)
+    s = int(rng.integers(-SHIFT, SHIFT + 1))
+    if s:
+        out = np.roll(out, s, axis=0)
+        if s > 0:
+            out[:s] = 255
+        else:
+            out[s:] = 255
+    return out
+
+
+class Pool:
+    """One training's crops (real, then synthetic), their targets and weights."""
+
+    def __init__(self, real: store.Crops, rows: pd.DataFrame, idx: np.ndarray, synth: store.Crops | None = None,
+                 synth_texts: list[str] | None = None, monitor: list[tuple[np.ndarray, str]] | None = None):
+        self.items = [real[int(i)] for i in idx]
+        self.texts = [str(t) for t in rows["text"].to_numpy()[idx]]
+        self.weights = [float(w) for w in rows["weight"].to_numpy()[idx]]
+        self.n_real = len(self.items)
+        self.n_synth = 0
+        if synth is not None:
+            self.items += [synth[i] for i in range(len(synth))]
+            self.texts += list(synth_texts)
+            self.weights += [1.0] * len(synth)
+            self.n_synth = len(synth)
+        self.widths = np.array([c.shape[1] for c in self.items])
+        self.monitor = monitor or []
+
+    def batches(self, rng, synth_share: float) -> list[np.ndarray]:
+        """BUCKET batches of indices, sorted by width within the draw, in a shuffled order."""
+        n = BATCH * BUCKET
+        if self.n_synth:
+            k = rng.binomial(n, synth_share)
+            idx = np.concatenate([rng.integers(0, self.n_real, n - k), self.n_real + rng.integers(0, self.n_synth, k)])
+        else:
+            idx = rng.integers(0, self.n_real, n)
+        idx = idx[np.argsort(self.widths[idx], kind="stable")]
+        chunks = [idx[i * BATCH:(i + 1) * BATCH] for i in range(BUCKET)]
+        return [chunks[j] for j in rng.permutation(BUCKET)]
+
+
+def targets(texts: list[str]) -> torch.Tensor:
+    """The strings as CTC's padded targets (n, longest or 1)."""
+    out = torch.zeros((len(texts), max(1, max(len(t) for t in texts))), dtype=torch.long)
+    for i, t in enumerate(texts):
+        if t:
+            out[i, :len(t)] = torch.tensor(model.encode(t))
+    return out
+
+
+def edit_distance(a: str, b: str) -> int:
+    prev = list(range(len(b) + 1))
+    for i, ca in enumerate(a, 1):
+        cur = [i]
+        for j, cb in enumerate(b, 1):
+            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
+        prev = cur
+    return prev[-1]
+
+
+def monitor_cer(net, pool: Pool, device: str) -> float | None:
+    """The best-path character error on the pool's monitor words."""
+    if not pool.monitor:
+        return None
+    net.eval()
+    errs = chars = 0
+    with torch.no_grad():
+        order = sorted(range(len(pool.monitor)), key=lambda i: pool.monitor[i][0].shape[1])
+        for s in range(0, len(order), 64):
+            part = [pool.monitor[i] for i in order[s:s + 64]]
+            x, frames = model.to_input([c for c, _ in part], quantize=True)
+            lp = F.log_softmax(net(x.to(device)).float(), -1).cpu()
+            for k, (_, text) in enumerate(part):
+                errs += edit_distance(ctc.best_path(lp[k, :frames[k]]), text)
+                chars += max(1, len(text))
+    net.train()
+    return errs / chars
+
+
+def fit(kind: str, pool: Pool, recipe: dict, device: str, seed: int = SEED, tag: str = "") -> tuple:
+    """One network ("reader" or "direction") trained on `pool` by `recipe` (see the module), in its own exclusive GPU
+    turn on mps.  Returns the network (on the CPU, in eval mode) and its log."""
+    torch.manual_seed(seed)
+    rng = np.random.default_rng(seed)
+    net = model.Reader() if kind == "reader" else model.Direction()
+    steps = recipe["steps"]
+    out = {"kind": kind, "recipe": recipe, "seed": seed, "device": device, "batch": BATCH, "real": pool.n_real,
+           "synth": pool.n_synth, "monitor": len(pool.monitor), "torch": torch.__version__, "steps": []}
+    with gpu.gpu_turn(True, device):
+        t0 = time.perf_counter()
+        net = net.to(device)
+        net.train()
+        opt = torch.optim.AdamW(net.parameters(), lr=recipe["max_lr"], weight_decay=WEIGHT_DECAY)
+        sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=recipe["max_lr"], total_steps=steps,
+                                                    pct_start=recipe["pct_start"])
+        queue: list = []
+        run_loss, run_n = 0.0, 0
+        for step in range(1, steps + 1):
+            if not queue:
+                queue = pool.batches(rng, SYNTH_SHARE)
+            idx = queue.pop()
+            crops = [augment(pool.items[i], rng) for i in idx]
+            if kind == "direction":
+                flip = rng.integers(0, 2, len(crops))
+                crops = [np.rot90(c, 2) if f else c for c, f in zip(crops, flip)]
+                x, _ = model.to_input(crops, quantize=True)
+                logit = net(x.to(device))
+                loss = F.binary_cross_entropy_with_logits(logit, torch.from_numpy(flip.astype(np.float32)).to(device))
+            else:
+                x, frames = model.to_input(crops, quantize=True)
+                texts = [pool.texts[i] for i in idx]
+                w = torch.tensor([pool.weights[i] for i in idx], dtype=torch.float32)
+                lens = torch.tensor([len(t) for t in texts], dtype=torch.long)
+                lp = F.log_softmax(net(x.to(device)), -1).permute(1, 0, 2)
+                nll = F.ctc_loss(lp, targets(texts).to(device), torch.tensor(frames, dtype=torch.long).to(device),
+                                 lens.to(device), blank=model.BLANK, reduction="none", zero_infinity=True)
+                loss = (nll / lens.clamp(min=1).to(device) * w.to(device)).sum() / w.sum().to(device)
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(net.parameters(), CLIP)
+            opt.step()
+            sched.step()
+            if step % LOSS_EVERY == 0 or step == steps:
+                run_loss += float(loss.detach().cpu())
+                run_n += 1
+            if step % LOG_EVERY == 0 or step == steps:
+                mean = run_loss / max(run_n, 1)
+                if not math.isfinite(mean):
+                    raise FloatingPointError(f"{tag}: loss {mean} at step {step}")
+                entry = {"step": step, "loss": round(mean, 5), "lr": sched.get_last_lr()[0],
+                         "seconds": round(time.perf_counter() - t0, 1)}
+                if kind == "reader":
+                    cer = monitor_cer(net, pool, device)
+                    entry["monitor_cer"] = None if cer is None else round(cer, 4)
+                out["steps"].append(entry)
+                log.info("%s %s", tag, entry)
+                run_loss, run_n = 0.0, 0
+        if gpu.on_gpu(device):
+            torch.mps.synchronize()
+        out["train_seconds"] = round(time.perf_counter() - t0, 1)
+        net = net.cpu()
+        if gpu.on_gpu(device):
+            torch.mps.empty_cache()
+    return net.eval(), out
+
+
+def monitor_words(real: store.Crops, rows: pd.DataFrame, q: int) -> list[tuple[np.ndarray, str]]:
+    """Up to MONITOR words of quarter q (their centre) on the 2000 scan, touching no answered block (seeded)."""
+    ok = np.flatnonzero(((rows["series"] == paths.SERIES) & (rows["kind"] != "none") & rows["text"].notna()
+                         & (rows["quarter"] == q) & ~rows["touch_blocks"].astype(bool)).to_numpy())
+    ok = ok[np.random.default_rng(MONITOR_SEED).permutation(len(ok))[:MONITOR]]
+    return [(real[int(i)], str(rows["text"].iat[int(i)])) for i in ok]
+
+
+def load_inputs() -> tuple[store.Crops, pd.DataFrame]:
+    f = store.CROPS_DIR / "crops.parquet"
+    if not f.is_file():
+        raise FileNotFoundError(f"can't read {f}: run `sfzmaps solver text-crops` (stage solver-text-crops)")
+    return store.Crops.load(store.CROPS_DIR / "crops.npz"), pd.read_parquet(f)
+
+
+def build_train(device: str | None = None, quarters=None) -> dict:
+    """Train every quarter's reader and classifier and write TRAIN_DIR (see the module).  `quarters`: a subset of
+    quarter names (all when None; for trials only: the stage trains all four).  Returns the logs and seconds."""
+    device = device or default_device()
+    torch.set_num_threads(THREADS)
+    cv2.setNumThreads(1)
+    t0 = time.perf_counter()
+    real, rows = load_inputs()
+    names = list(paths.QUARTERS) if quarters is None else list(quarters)
+    part = runs.fresh_folder(store.TRAIN_DIR)
+    held, logs, tables = {}, {}, {}
+    for name in names:
+        q = paths.QUARTERS.index(name)
+        idx = store.training_rows(rows, q)
+        text_idx = store.training_rows(rows, q, text_only=True)
+        syn = store.Crops.load(store.CROPS_DIR / f"synth_{name}.npz")
+        syn_rows = pd.read_parquet(store.CROPS_DIR / f"synth_{name}.parquet")
+        pool = Pool(real, rows, idx, syn, list(syn_rows["text"]), monitor_words(real, rows, q))
+        log.info("%s held out: reader on %d real + %d synthetic crops (%s)", name, pool.n_real, pool.n_synth, device)
+        net, lg = fit("reader", pool, READER, device, SEED, tag=f"{name} reader")
+        model.save(part / f"{name}.pt", net, quarter=name, recipe=READER, seed=SEED, real=pool.n_real,
+                   synth=pool.n_synth)
+        del net, pool
+        dpool = Pool(real, rows, text_idx)
+        log.info("%s held out: 0/180 classifier on %d real crops", name, dpool.n_real)
+        dnet, dlg = fit("direction", dpool, DIRECTION, device, SEED, tag=f"{name} direction")
+        model.save(part / f"{name}_direction.pt", dnet, quarter=name, recipe=DIRECTION, seed=SEED, real=dpool.n_real)
+        del dnet, dpool
+        axes, turned = ctc.axis_and_turn(rows["angle"].to_numpy(float)[text_idx])
+        tables[name] = ctc.axis_prior(axes, turned)
+        kinds = rows["kind"].to_numpy()[idx]
+        held[name] = {"quarter": q, "seed": SEED, "reader": READER, "direction": DIRECTION,
+                      "real_crops": int(len(idx)),
+                      "real_by_kind": {k: int((kinds == k).sum()) for k in sorted(set(kinds))},
+                      "synthetic_crops": int(len(syn)), "direction_crops": int(len(text_idx)),
+                      "direction_words_turned": int(turned.sum()),
+                      "monitor_words": lg["monitor"], "monitor_cer_last": lg["steps"][-1].get("monitor_cer")}
+        logs[name] = {"reader": lg, "direction": dlg}
+    store.save_npz(part / "axis_prior.npz", step=np.float64(ctc.AXIS_STEP), sd=np.float64(ctc.AXIS_SD),
+                   **{f"table_{n}": t for n, t in tables.items()})
+    (part / "held.json").write_text(json.dumps({"quarters": names, "device": device, "train": held,
+                                                "synth_share": SYNTH_SHARE, "batch": BATCH, "bucket": BUCKET},
+                                               indent=1) + "\n")
+    (part / "log.json").write_text(json.dumps(logs, indent=1) + "\n")
+    runs.replace_folder(part, store.TRAIN_DIR)
+    return {"held": held, "device": device, "seconds": round(time.perf_counter() - t0, 1)}
